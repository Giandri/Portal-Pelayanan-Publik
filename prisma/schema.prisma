generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Permit {
  id              String          @id @default(cuid())
  trackingId      String          @unique
  type            String
  name            String
  nik             String?
  email           String
  phone           String
  agencyName      String?
  agencyCategory  String?
  subject         String
  description     String
  status          String          @default("PENDING")
  rejectionReason String?
  date            DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  isArchived      Boolean         @default(false)
  history         StatusHistory[]
  attachments     Json?
  survey          Survey?
}

model Survey {
  id          String     @id @default(cuid())
  rating      Int
  comment     String?
  permitId    String?    @unique
  permit      Permit?    @relation(fields: [permitId], references: [id], onDelete: Cascade)
  guestBookId String?    @unique
  guestBook   GuestBook? @relation(fields: [guestBookId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
}

model StatusHistory {
  id        String   @id @default(cuid())
  status    String
  note      String?
  permitId  String
  permit    Permit   @relation(fields: [permitId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  createdBy String?
}

model GuestBook {
  id             String   @id @default(cuid())
  trackingId     String   @unique
  name           String
  email          String
  nik            String
  agencyName     String?
  agencyCategory String?
  phone          String
  subject        String
  description    String?
  isScanned      Boolean  @default(false)
  createdAt      DateTime @default(now())
  survey         Survey?
}
